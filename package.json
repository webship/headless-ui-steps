{
  "name": "@webship-js/headless-ui-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for sites and apps built with Headless UI (Tailwind Labs' unstyled, accessible components for React and Vue): menus, select and search lists, dialogs, popovers, panels, tabs, switches, radio groups and fields, each waiting on the component's own state and the end of its transitions, never a fixed time. For webship-js.",
  "main": "tests/step-definitions/headless-ui-helpers.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "demo-src/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js",
    "demo:build": "bash .github/scripts/build-demo.sh",
    "demo:serve": "bash .github/scripts/serve-demo.sh",
    "vue:build": "bash .github/scripts/build-vue.sh",
    "vue:serve": "bash .github/scripts/serve-vue.sh"
  },
  "keywords": [
    "webship-js",
    "cucumber",
    "playwright",
    "bdd",
    "react",
    "vue",
    "step-definitions",
    "headless-ui",
    "headlessui",
    "tailwindcss"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/headless-ui-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/headless-ui-steps/issues"
  },
  "homepage": "https://github.com/webship/headless-ui-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.19"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.19"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
